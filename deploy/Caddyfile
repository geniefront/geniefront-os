# origin 侧反代。Cloudflare 在前面，回源用 Full (strict)，
# 所以这里需要一张真证书 —— Caddy 自动申请 Let's Encrypt。

{
	email ops@geniefront.com
	admin off
}

api.geniefront.com {
	# 真实客户端 IP 在 CF-Connecting-IP，Fastify 的 trustProxy 会读 X-Forwarded-For
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		health_uri /health
		health_interval 10s
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
