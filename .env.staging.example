# Copy to .env.staging. Never commit the populated file.
GF_ENV=staging
PORT=3000
LOG_LEVEL=info
API_HOST=staging-api.geniefront.com
DESK_HOST=staging-desk.geniefront.com
KIOSK_HOST=staging-kiosk.geniefront.com
PLATFORM_HOST=staging-ops.geniefront.com
MARKETING_HOST=staging.geniefront.com
MARKETING_WWW_HOST=staging-www.geniefront.com
BOOKING_HOST=staging-book.geniefront.com
APP_URL=https://staging-api.geniefront.com
VITE_API_BASE=https://staging-api.geniefront.com
APP_BASE_URL=https://staging-desk.geniefront.com
MARKETING_BASE_URL=https://staging.geniefront.com
FORM_BASE_URL=https://staging-desk.geniefront.com
PLATFORM_BASE_URL=https://staging-ops.geniefront.com
KIOSK_BASE_URL=https://staging-kiosk.geniefront.com
BOOKING_PAGE_ORIGIN=https://staging-book.geniefront.com
VITE_BOOKING_ORIGIN=https://staging-book.geniefront.com
# Keep off until the staging booking app and manage route are verified.
BOOKING_MANAGE_PAGE_ENABLED=
APP_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AI_TOPUP=
FORM_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# 邮件供应商：resend（当前在用）| ses。⚠️ SES 账号仍在沙箱，
# 只有已验证的收件地址能收到邮件，脱离沙箱后才能改成 ses。
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# 没配时 POST /v1/webhooks/resend 一律回 401（那条路由会写抑制名单）
RESEND_WEBHOOK_SECRET=
FROM_EMAIL='GenieFront <noreply@notify.geniefront.com>'
CUSTOMER_FROM_EMAIL='GenieFront Bookings <noreply@appointment.geniefront.com>'
# 营销发件域，所有门店共用；门店身份体现在本地部分上
MARKETING_EMAIL_DOMAIN=mkt.geniefront.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=
AWS_SNS_REGION=us-east-2
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_ASSISTANT_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SMS_FROM=
TELNYX_RATE_PER_MIN_MILLICENTS=6200
TELNYX_RECONCILE_MINUTES=15
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BRIGHT_DATA_API_KEY=
YELP_CLIENT_ID=
YELP_API_KEY=
# 测试通信（详见 .env.example 的 E 段）。staging 不真发邮件和短信。
COMMUNICATION_DELIVERY_MODE=capture
STAGING_OTP_CODE=424242
STAGING_OTP_PHONES=+1617555*
