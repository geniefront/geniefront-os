{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:api:local"
      ],
      "port": 3000
    },
    {
      "name": "api-staging",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gf/api",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gf/web",
        "dev"
      ],
      "port": 5177
    }
  ]
}
