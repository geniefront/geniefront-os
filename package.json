{
  "name": "geniefront-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @gf/api dev",
    "dev:web": "pnpm --filter @gf/web dev",
    "dev:desk": "pnpm --filter @gf/web dev",
    "dev:front-desk": "pnpm --filter @gf/web dev",
    "dev:ipad": "pnpm --filter @gf/ipad dev",
    "dev:kiosk": "pnpm --filter @gf/ipad dev",
    "dev:platform": "pnpm --filter @gf/platform dev",
    "dev:marketing": "pnpm --filter @gf/marketing dev",
    "dev:booking": "pnpm --filter @gf/booking dev",
    "local:setup": "bash scripts/local-supabase.sh setup",
    "local:start": "bash scripts/local-supabase.sh start",
    "local:stop": "bash scripts/local-supabase.sh stop",
    "local:status": "bash scripts/local-supabase.sh status",
    "env:check:local": "bash scripts/env-guard.sh local",
    "env:check:staging": "bash scripts/env-guard.sh staging",
    "env:check:production": "bash scripts/env-guard.sh production",
    "dev:api:local": "bash scripts/run-env.sh local pnpm --filter @gf/api dev:raw",
    "dev:web:local": "bash scripts/run-env.sh local pnpm --filter @gf/web exec vite --port 5177 --host 0.0.0.0",
    "deploy:staging": "bash deploy/deploy.sh staging",
    "deploy:production": "bash deploy/deploy.sh production",
    "migrate:staging": "bash scripts/migrate-env.sh staging",
    "migrate:production": "bash scripts/migrate-env.sh production",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @gf/db test && pnpm --filter '!@gf/db' test",
    "test:unit": "pnpm --filter '!@gf/api' --filter '!@gf/db' test",
    "test:e2e": "GF_QA_ALLOW_RESET=1 NODE_ENV=test playwright test",
    "test:e2e:ui": "GF_QA_ALLOW_RESET=1 NODE_ENV=test playwright test --ui",
    "diagnose:comms:local": "bash scripts/run-env.sh local pnpm --filter @gf/db exec tsx src/ops/diagnoseComms.ts",
    "diagnose:comms:staging": "bash scripts/run-env.sh staging pnpm --filter @gf/db exec tsx src/ops/diagnoseComms.ts",
    "lint:guards": "bash scripts/lint-guards.sh",
    "check:env": "bash scripts/check-env.sh",
    "db:generate": "pnpm --filter @gf/db generate",
    "db:migrate": "pnpm --filter @gf/db migrate",
    "db:seed": "pnpm --filter @gf/db seed",
    "qa:reset": "tsx packages/db/src/qa/cli.ts reset",
    "qa:seed": "tsx packages/db/src/qa/cli.ts seed",
    "db:tidy": "pnpm --filter @gf/api tidy",
    "setup:test:reset": "pnpm --filter @gf/db setup-test-reset",
    "verify": "pnpm lint:guards && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
