# ═══════════════════════════════════════════════════════════════════════════
#  GenieFront OS · 环境变量模板
# ═══════════════════════════════════════════════════════════════════════════
#
#  用法：cp .env.example .env  然后把值填进 .env
#  .env 已在 .gitignore 里，永远不要提交。
#
#  每一项都标了【长这样】和【最容易复制错的地方】。
#  填完跑一遍：  bash scripts/check-env.sh
#  它会先查格式，再真的调一次 API，告诉你哪个 key 是错的。
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# 应用自身
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# 前端（web / platform / marketing / ipad）构建时注入的 API origin。
# apps/marketing 的 Checkout 请求打到这里。
VITE_API_BASE=http://localhost:3000
LOG_LEVEL=debug

# PIN / 设备令牌用的受限 JWT 签名密钥。自己生成，不用去任何网站拿：
#   openssl rand -base64 48
# 长这样（64 字符 base64）：
#   APP_JWT_SECRET=Kx7pQ2mNvR8sT4wY6zA1bC3dE5fG9hJ0kL2mN4pQ6rS8tU0vW2xY4zA6bC8dE0fG
APP_JWT_SECRET=
# Optional dedicated manage-token wrap key (preferred). HKDF info
# gf-manage-token-wrap:dedicated:v1. If unset, wraps derive from APP_JWT_SECRET.
# Rotate by setting MANAGE_TOKEN_WRAP_KEY_PREVIOUS (or APP_JWT_SECRET_PREVIOUS)
# to the old value so already-issued wraps still unwrap.
# MANAGE_TOKEN_WRAP_KEY=
# MANAGE_TOKEN_WRAP_KEY_PREVIOUS=
# APP_JWT_SECRET_PREVIOUS=


# ═══════════════════════════════════════════════════════════════════════════
#  🔴 A · Phase 0 必需（没有这些开不了工）
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# A1 · Supabase
#      Dashboard → 你的项目 → Project Settings → API
# ───────────────────────────────────────────────────────────────────────────

# 【长这样】https://<20个小写字母>.supabase.co
# 【常见错误】末尾多了斜杠 /、或者复制成了 Dashboard 的网址
#             （dashboard 网址长这样 https://supabase.com/dashboard/project/xxx —— 那个是错的）
# 正确示例：SUPABASE_URL=https://kqwbvzmnrtxdlghjfpce.supabase.co
SUPABASE_URL=

# 前端用的公开 key。两种格式，看你项目建于什么时候，**有哪个填哪个**：
#   新格式（2025 之后建的项目，推荐）：sb_publishable_ + 约 30 字符
#     SUPABASE_ANON_KEY=sb_publishable_A1b2C3d4E5f6G7h8I9j0K1l2M3
#   旧格式（JWT）：eyJ 开头，三段用 . 隔开，200+ 字符，非常长
#     SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtxdyIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzM1Njg5NjAwfQ.aB3dE5fG7hJ9kL1mN3pQ5rS7tU9vW1xY3zA5bC7dE9
# 【常见错误】⚠️ 复制成了 service_role / secret key —— 那个绝不能放前端。
#             旧格式的 anon key 解开来 role 是 "anon"，service_role 的是 "service_role"。
#             新格式看前缀：publishable = 公开的，secret = 服务端的。
SUPABASE_ANON_KEY=

# ⚠️ 两条连接串，角色不同 —— 这是 RLS 能兜底的前提

# ① 应用运行时：受限角色 app_user。没有 BYPASSRLS，漏写 WHERE 也串不了租户。
#    密码由 APP_DB_PASSWORD 决定，migrate.ts 会把它设到角色上。
#    postgresql://app_user.<项目ref>:<APP_DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ② 迁移专用：postgres 角色。只有 packages/db 的 migrate/seed 读它。
#    Project Settings → Database → Connection string → **Transaction pooler**
# 【常见错误 ×3，这一项最容易出问题】
#   1. ⚠️ 忘了把 [YOUR-PASSWORD] 换成真密码 —— Supabase 复制的串里字面就是这个占位符
#   2. ⚠️ 端口拿成 5432（Session pooler）。要 **6543**（Transaction pooler）
#   3. ⚠️ 主机名前缀是 aws-0 还是 aws-1 因项目而异，复制控制台给的那条，别手改
MIGRATION_DATABASE_URL=

# app_user 的登录密码。自己生成，不用去任何网站拿：
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
APP_DB_PASSWORD=

# ⚠️ 数据库测试专用。API/DB 测试会写表、删数据和修改授权；未同时配置下面
# 三项时会在建立连接前直接拒绝运行。它们必须指向独立 test 项目、临时
# Supabase branch 或一次性本地 PostgreSQL，绝不能复制上面的 dev/prod 连接串。
DATABASE_TEST_TARGET=
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
TEST_APP_DB_PASSWORD=

# Google Places API (New)：开店向导搜索并导入 Google 商家资料。
# Google Cloud Console 中启用 Places API (New)，仅供服务端使用。
GOOGLE_PLACES_API_KEY=

# service_role key —— 绕过 RLS 的万能钥匙。开发期存这里没问题，用于跑迁移和灌种子数据。
#
# 【长这样】和 anon key 同样两种格式，看项目新旧：
#   新格式：sb_secret_A1b2C3d4E5f6G7h8I9j0K1l2M3
#   旧格式：eyJ 开头的 JWT，解开来 role 是 "service_role"（anon 那个是 "anon"）
# 【常见错误】⚠️ 和 ANON_KEY 填反 —— 两个在 Settings → API 同一个页面上下挨着。
#             check-env.sh 会把 JWT 解开看 role，填反了直接报错。
#
# ⚠️ 两条硬规矩（宪法第 5 条）：
#   1. **只有 packages/db 的迁移与种子脚本可以读它。**
#      apps/api 的任何业务代码引用到这个变量 = CI 直接失败。
#      理由不是洁癖：一旦业务查询走了 service_role，RLS 就被静默绕过，
#      你写的所有租户隔离测试会**全部通过但毫无意义**，直到某天线上串了数据才发现。
#   2. **生产环境的这一把不要落到任何 .env 文件里**，只进 GitHub Actions 的 Repository Secret。
#      这里填的应该是 **dev 项目**那一把。
SUPABASE_SERVICE_ROLE_KEY=

# 可选：可重复跑开店向导的专用账号。每次执行 `pnpm setup:test:reset`
# 都会归档上一轮测试店，并创建一间“Stripe 测试付款成功、已认领、待 setup”的空店。
# 邮箱必须以 @example.test 结尾，脚本会拒绝真实邮箱。
SETUP_TEST_EMAIL=setup@example.test
SETUP_TEST_PASSWORD=GenieSetup!2026


# ───────────────────────────────────────────────────────────────────────────
# A2 · Anthropic
#      console.anthropic.com → Settings → API Keys → Create Key
# ───────────────────────────────────────────────────────────────────────────

# 【长这样】sk-ant-api03- 开头，总长约 108 字符
#   ANTHROPIC_API_KEY=sk-ant-api03-A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6A7b8C9d0E1f2G3h4I5j6K7l8M9n0O1p2Q3r4S5t6U7v8AA
# 【常见错误】
#   ⚠️ 复制成了 Admin key（sk-ant-admin... 开头）—— 那个是管账号的，调不了模型
#   ⚠️ key 只在创建时显示一次，没存下来就只能重新建一个
# 【建议】创建后去 Settings → Limits 设个 $50/月上限，防止调试写错循环烧钱
ANTHROPIC_API_KEY=


# ───────────────────────────────────────────────────────────────────────────
# A3 · Cloudflare
# ───────────────────────────────────────────────────────────────────────────

# API Token：右上角头像 → My Profile → API Tokens → Create Token
#   权限勾这两条：Zone → DNS → Edit    /    Account → Cloudflare Pages → Edit
# 【长这样】40 个字符，字母数字加下划线和短横，**没有前缀**
#   CLOUDFLARE_API_TOKEN=v1V_8kQ2mN4pR6sT8wY0zA2bC4dE6fG8hJ0kL2mN
# 【常见错误】⚠️ 复制成了 Global API Key（37 位纯十六进制，页面上就在旁边）
#             Global Key 权限过大且格式不同，check-env.sh 会直接告诉你拿错了
CLOUDFLARE_API_TOKEN=

# ⚠️⚠️ 下面两个都是 32 位十六进制，长得一模一样，最容易搞混：
#   Account ID —— 任意域名的 Overview 页，右侧栏最下面 "Account ID"
#   Zone ID    —— 同一个页面，右侧栏 "Zone ID"（就在 Account ID 上面一点）
# 记法：Zone = 这个域名的，Account = 你整个账号的。填反了 Pages 部署会失败。
#   CLOUDFLARE_ACCOUNT_ID=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
#   CLOUDFLARE_ZONE_ID=f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=


# ───────────────────────────────────────────────────────────────────────────
# A4.0 · 邮件供应商的开关
# ───────────────────────────────────────────────────────────────────────────
#
# resend（默认，当前生产在用） | ses
#
# ⚠️ SES 账号目前**仍在沙箱**：只有已在 SES 验证过的收件地址能收到邮件，
# 发往其余地址一律 MessageRejected。所以现在必须是 resend。
# 脱离沙箱后改这一行即可切换，不需要改代码 —— 但要一起确认三件事：
#   1. 三个发件域（notify. / appointment. / mkt.）在 SES 那边也验证过
#      （SES 侧当前验的是另外三个：mail. / app. / 根域，DKIM 记录不一样）
#   2. SES 的投递回调配好了（SES_CONFIGURATION_SET + SES_SNS_TOPIC_ARN）
#   3. 切换当天「送达率」会断崖 —— 那是 provider_id 口径变了，不是投递故障
#
# ⚠️ 这个值打错字时**回退到 resend**，不是报错。理由是最坏情况必须是
# 「继续用当前能真正送达的那一家」，而不是「切进沙箱后所有邮件被静默拒收」。
EMAIL_PROVIDER=resend

# ───────────────────────────────────────────────────────────────────────────
# A4.1 · Resend（当前在用）
#        resend.com → API Keys → Create API Key（权限选 Full access）
# ───────────────────────────────────────────────────────────────────────────

# 【长这样】re_ 开头，后面约 30 字符
#   RESEND_API_KEY=re_A1b2C3d4_E5f6G7h8I9j0K1l2M3n4O5p6
# 【常见错误】⚠️ 权限建成了 "Sending access" 但域名选错，发信会 403
RESEND_API_KEY=

# ── Resend 的投递回调（docs/26 §5）─────────────────────────────────────────
#
# 退信与投诉的回流入口。不接的话，系统对一封信的下场一无所知：状态停在
# `sent`，而那只表示 Resend 收下了。于是一个早已不存在的邮箱每次预约都再
# 退信一次，一位点过「举报垃圾邮件」的顾客下个月照样收到营销邮件 ——
# 两者都直接扣发信域名的信誉。
#
# ⚠️ 没配这一项时，`POST /v1/webhooks/resend` **一律回 401**，不是放行。
# 一个不验签的公开写接口，等于任何人都能把任意地址塞进抑制名单 ——
# 那是一个「让某家店的顾客再也收不到确认信」的接口。
#
# 在 Resend 控制台 → Webhooks → Add Endpoint 之后复制那串 whsec_ 开头的值。
# 【长这样】whsec_MfKQ9r8vZ3xT1wY5aB7cD2eF4gH6jK8m
RESEND_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────────────
# A4.2 · AWS SES（备用，脱离沙箱后启用）
# ───────────────────────────────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ⚠️ SES 的身份按区域独立；本项目 SES 侧的域名验证在 us-east-2
AWS_REGION=us-east-2
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=

# ── 三个发件域名（docs/26 §4）─────────────────────────────────────────────
#
# 店家事务  noreply@notify.geniefront.com        订阅、账单、平台通知
# 客户事务  noreply@appointment.geniefront.com   预约确认 / 变更 / 提醒、表单邀请
# 客户营销  <门店标签>@mkt.geniefront.com        每店一个本地部分
#
# ⚠️ 划分依据是**信誉隔离**：营销邮件的投诉率天然高于事务性邮件，而发信信誉
# 按域名累积。混用一个域时，一家店的营销投诉会直接拉低所有门店预约确认邮件的
# 送达率 —— 而那件事不会有任何人来投诉，只表现为到店率下降。
#
# ⚠️ 营销侧的隔离**只到「营销 vs 事务」这一层**：全部门店共用 mkt. 一个域，
# 门店身份来自本地部分，因此**门店之间的营销信誉是共享的**。这是拿「每店一个
# 子域要每店一套 DNS 验证」换来的简化。事务性邮件不受影响。
#
# ⚠️ 三个域名都**必须在当前 EMAIL_PROVIDER 那一家验证通过**。
# ⚠️ 带空格或 <> 的值**必须加引号**：文档教的启动方式是 `set -a && . ./.env`
#    （shell 源入），不加引号的 `<` 会被当成重定向，整个 .env 解析失败，
#    症状是「api 起不来，报一个和邮件毫无关系的 parse error」
FROM_EMAIL='GenieFront <noreply@notify.geniefront.com>'
CUSTOMER_FROM_EMAIL='GenieFront Bookings <noreply@appointment.geniefront.com>'

# 营销发件域。⚠️ 变量名 2026-09-02 由 MARKETING_EMAIL_ROOT_DOMAIN 改名而来：
# 旧名字的值是「子域挂在哪个根域下」（geniefront.com），新名字就是发件域本身。
# 改名是为了让旧值失效而不是被误用 —— 沿用旧值会从一个没验证的域发信，整批退信。
MARKETING_EMAIL_DOMAIN=mkt.geniefront.com

# Elastic Email
ELASTICEMAIL_API_KEY=
ELASTIC_EMAIL_API_KEY=
# 事务发送专用密钥（AccessLevel 仅 SendHttp）；由 scripts/elastic-email-setup.mjs bootstrap 生成。
ELASTICEMAIL_SEND_API_KEY=
# 子账户密钥的封装密钥，32 字节 base64；缺失时不会创建任何远端凭据。
EMAIL_CREDENTIAL_ENCRYPTION_KEY=
# 投递通知凭据。供应商只能配置 URL，实际路径用该密钥派生的公开标识，密钥本身不进 URL。
ELASTICEMAIL_WEBHOOK_SECRET=
# 账户不允许按邮件关闭追踪时置 1：跳过每进程一次的探测请求，直接按账户默认设置发送。
ELASTICEMAIL_TRACKING_LOCKED=

# ───────────────────────────────────────────────────────────────────────────
# AWS SNS —— 只用于**建**投递回调的主题与订阅，不参与验签
# ───────────────────────────────────────────────────────────────────────────
#
# ⚠️ 当前**没有任何代码读这三项**。SNS 回调的验签走的是消息自带的 X.509 证书
# （公钥验签，我们不持有密钥），因此收回调不需要 AWS 凭据。这里留着是给
# 「用命令行建主题 / 建订阅 / 配事件目标」那一步用的。
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=
AWS_SNS_REGION=us-east-2


# ═══════════════════════════════════════════════════════════════════════════
#  🟡 B · Phase 1b 才需要（约 6–10 周后，先留空）
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# Upstash Redis（BullMQ 队列：邮件定时提醒、报表导出）
#      console.upstash.com → Create Database，区域选和 Supabase 同一个
# ───────────────────────────────────────────────────────────────────────────

# ⚠️⚠️ **BullMQ 要 TCP 连接串，不是 REST URL！**
#   Upstash 控制台最显眼的是 REST API（https://xxx.upstash.io + 一个 token），
#   但 **BullMQ 走 Redis 协议，REST 那套接不上**。
#
# 【好消息】Upstash 的 REST token 同时就是 Redis 的密码，所以拿到 REST 那对
#   就能自己拼出来，不用再去找：
#     rediss://default:<REST_TOKEN>@<REST_URL 去掉 https:// 的部分>:6379
#   例：REST 是 https://expert-bream-142058.upstash.io + token abc…
#       → rediss://default:abc…@expert-bream-142058.upstash.io:6379
#
# 【记法】rediss 是两个 s（带 TLS），不是 redis://
# 【区域】⚠️ 建这个库时区域要选 **us-east-1**，和 Supabase 同区。
#   跨区的话每次入队/出队都要多一个来回，队列本来就是高频操作。
UPSTASH_REDIS_URL=rediss://default:A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6@apn1-clever-mole-31415.upstash.io:6379
# 【记法】rediss 是两个 s（带 TLS），不是 redis://
UPSTASH_REDIS_URL=


# ═══════════════════════════════════════════════════════════════════════════
#  🟢 C · Phase 2 才需要（约 4–6 个月后，先留空）
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# Telnyx ⭐（号码 + 语音 + AI Assistant 对话 + Phase 2.5 的短信）
#      portal.telnyx.com
#
#  2026-08-16 起，AI 语音与短信统一走 Telnyx，替换原来的 Twilio + Vapi
#  两个供应商（`03` 决策 28）。完整方案见 docs/09-TELNYX.md。
# ───────────────────────────────────────────────────────────────────────────

# 服务端调 API 用。控制台 → API Keys
#   TELNYX_API_KEY=KEY0123456789ABCDEF...
TELNYX_API_KEY=

# ⚠️⚠️ 最容易漏的一个，而且漏了不会报错，只会留一个安全洞。
#
#  它**不是**用来调 API 的，是用来**验证打进来的 webhook 是不是真的来自 Telnyx**
#  （Ed25519 签名）。没有它，任何人都能 POST 一条「客人预约了明天三点」
#  进你的前台复核队列，甚至触发计费事件。
#
#  控制台 → Account Settings → Public Key（base64，和 API Key 长得完全不同）
#  ⚠️ dev 与 prod 用**不同的 key**，别图省事共用一个
TELNYX_PUBLIC_KEY=

# 【长这样】E.164：+1 加 10 位数字，**没有空格、括号、短横**
#   TELNYX_PHONE_NUMBER=+15125550142
# 【常见错误】⚠️ 复制成了控制台显示的 (512) 555-0142 那种带格式的
TELNYX_PHONE_NUMBER=

# AI Assistant 的 id（控制台 → AI → Assistants）
TELNYX_ASSISTANT_ID=

# 短信用。10DLC 批准后在控制台/API 建一个 messaging profile，把发送号挂上去
# 【长这样】4001a029-e472-4e04-a2f9-7dd6acb4e2ac
TELNYX_MESSAGING_PROFILE_ID=

# 发确认短信的主叫号（E.164）。
# ⚠️ 和 TELNYX_PHONE_NUMBER 是**两个号**：那个是每店的语音落地号，
# 这个是平台统一的短信发送号 —— 客人回复进 GenieFront 客服，店家完全不碰（09 §5）
TELNYX_SMS_FROM=

# 手机验证码上机（sql/0031、docs/09 §5）—— Telnyx 控制台 → Verify → 新建一个
# Verify Profile（SMS 类型，绑上面那个 messaging profile），把它的 id 填在这里。
#
# ⚠️ 没配这一条时，技师端的「手机号」那条登录路会明确报「短信通道还没开通」，
# 而**不会**假装发了一条 —— 后者会让技师在登录页反复点重发，每一次都真的花钱。
# 技师照样能用「上机码」进来（老板念给他的 6 位数字），那条不经过任何运营商。
#
# ⚠️ 美国 A2P 10DLC 批下来之前，验证码大概率被运营商静默过滤（09 §1.1）。
TELNYX_VERIFY_PROFILE_ID=

# ⭐ 验证码短信实际走的是 **Twilio Verify**（2026-08-18 定，临时）。
#
# 为什么不是 Telnyx：美国 A2P 10DLC 在 Telnyx 名下要重新排队（09 §1.1），
# 批下来之前长号码发的验证码会被运营商**静默**过滤 —— 而「静默」是最糟的失败方式。
# Twilio Verify 走它自己那套为 OTP 预注册的通道，绕开了这条排队。
#
# **语音仍然是 Telnyx**，这里只是登录验证码。等 Telnyx 的 10DLC 批下来，
# 删掉下面这行 TWILIO_VERIFY_SERVICE_SID 就自动切回 Telnyx，不用改代码。
#
# Twilio 控制台 → Verify → Services → 新建一个，拿 SID（VA 开头）
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────────────────
# Twilio / Vapi（旧 AI 电话方案 —— 过渡期保留，可全部留空）
#
#  ⚠️ 不要注销这两个账号，理由有两条（docs/09-TELNYX.md §1.1）：
#    1. Telnyx 的口音实测没通过时要回退到这条路
#    2. Twilio 那边正在审的 10DLC 要留着，直到 Telnyx 的批下来 ——
#       换 CSP 等于重新排队，「两边都没有」是唯一会真正卡死 Phase 2.5 的状态
# ───────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VAPI_API_KEY=
VAPI_PUBLIC_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Stripe（向门店收订阅费。⚠️ 需要公司实体 + EIN 完成业务认证）
#      dashboard.stripe.com → Developers → API keys
# ───────────────────────────────────────────────────────────────────────────

# 【开发期一律用 test key】sk_test_ 开头，约 107 字符
#   STRIPE_SECRET_KEY=sk_test_51A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6A7b8C9d0E1f2G3h4I5j6K7l8M9n0O1p2Q3r4S5
# 【常见错误】
#   ⚠️ 用了 live key（sk_live_）在开发环境 —— 会真的扣钱
#   ⚠️ 复制成了 Restricted key（rk_ 开头）—— 权限不够，建订阅会失败
STRIPE_SECRET_KEY=

# 【长这样】pk_test_ 开头，长度和 secret key 差不多
#   STRIPE_PUBLISHABLE_KEY=pk_test_51A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6A7b8C9d0E1f2G3h4I5j6K7l8M9n0O1p2Q3r4S5
STRIPE_PUBLISHABLE_KEY=

# Webhook 签名密钥。Developers → Webhooks → 点进你建的那个 endpoint → Signing secret
# 【长这样】whsec_ 开头 + 32 字符
#   STRIPE_WEBHOOK_SECRET=whsec_A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6
# 【常见错误】⚠️ 每个 endpoint 有各自的 secret，本地测试用 `stripe listen` 会给你另一个，别混用
STRIPE_WEBHOOK_SECRET=

# ⭐ 套餐对应的 Stripe Price id（Products → 建两个循环价格 → 复制 price_ 开头的 id）
# 【长这样】price_1A2b3C4d5E6f7G8h
# 【名字必须和 Stripe 后台对上】Essential $99/月、Growth $199/月（决策 8）。
#   套餐内含的额度写在代码里（@gf/payroll 的 PLAN_QUOTAS）：
#   Essential 500 积分 + 60 语音分钟；Growth 1200 积分 + 500 分钟。
#   代码里的 plan 枚举与 DB 约束也是 essential / growth —— 三处对不上的话，
#   等到有人对着 Stripe 后台查一笔账时，谁也说不清哪个是哪个。
# 【为什么价格不写在代码里】那两个数字还要用真实账单校准（`04` §4.1）——
#   写死在代码里意味着调价要发一次版，而调价是运营动作。
# 【常见错误】⚠️ 复制成了 Product id（prod_ 开头）—— 建 Checkout 时会 400
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_GROWTH=

# ⏳ **代码不用这个**。充值（$50 = 1000 积分 或 200 分钟）走 PaymentIntent，
# 金额与单位都是代码常量（@gf/payroll 的 TOPUP_PRICE_CENTS / TOPUP_UNITS），
# 不经过 Price 对象 —— 这样加一档只要改一个数组，不用回后台建 price。
# 留着是为了以后真要改成走 Checkout 时不用再找一遍。
STRIPE_PRICE_AI_TOPUP=

# 老板从 Stripe 托管页付完款回跳到哪。**只用它的域名**，
# 客户端传来的回跳地址只保留 path（防开放重定向，见 stripe/routes.ts 的 safeReturnUrls）
# 【长这样】https://desk.geniefront.com  本地开发填 http://localhost:5177
# ⚠️ 这是 desk（apps/web），不是 marketing。不要填成 .app。
APP_BASE_URL=http://localhost:5177

# 公开营销站（apps/marketing）的对外 origin。
# `POST /v1/public/signup-checkout` 的 Stripe success/cancel URL **只认这一项**，
# 浏览器传进来的回跳地址一律丢掉。
# 【长这样】https://www.geniefront.com  本地开发填 http://localhost:5180
# ⚠️ 不要填 desk.geniefront.com，也不要填 .app。
MARKETING_BASE_URL=http://localhost:5180

# ── 健康表填表链接（docs/15 §4）─────────────────────────────────────────────
#
# 客人扫码 / 点邮件里的按钮之后落在哪。二维码里装的就是
# `${FORM_BASE_URL}/forms/intake?t=fs_…`，由 apps/web 的公共路由承载；
# 页面无需登录，能看到的模板仍由一次性令牌限定。
#
# ⚠️ 填错的表现很安静：码扫得开，但客人落在一个 404 上，
# 而前台屏幕上一切正常 —— 她以为发出去了。
# 【长这样】https://desk.geniefront.com  本地开发填 http://localhost:5177
FORM_BASE_URL=http://localhost:5177


# ── 托管预约页 origin（book.geniefront.com）────────────────────────────────
#
# Canonical guest URLs:
#   https://book.geniefront.com/{slug}
#   https://book.geniefront.com/l/{slug}#g/{token}
#
# Add book.geniefront.com (and the staging host) to Turnstile allowed hostnames.
# 【长这样】https://book.geniefront.com  本地开发填 http://127.0.0.1:5176
BOOKING_PAGE_ORIGIN=http://127.0.0.1:5176
VITE_BOOKING_ORIGIN=http://127.0.0.1:5176

# ── 顾客自助改期 / 取消页（docs/13 §4.6）───────────────────────────────────
#
# The booking app and /l/{slug}#g/{token} route exist, but outbound manage
# links stay off until that production route is deployed and verified.
#
# ⚠️ Keep this empty until verification. Turning it on too early puts a
# manage URL into SMS/email that guests cannot open.
#
# 页面上线并验证后在对应环境置 1，无需改代码。
# 【长这样】1 或留空
BOOKING_MANAGE_PAGE_ENABLED=


# ───────────────────────────────────────────────────────────────────────────
# Telnyx 分钟单价（计费用，⏳ 等开户实测再填 —— 09 §6）
# ───────────────────────────────────────────────────────────────────────────

# 一分钟 AI 电话的**成本**，单位毫分（1/1000 分）。$0.15/分钟 = 15 分 = 15000 毫分
# 【留空 = 不计费】现在恒为 0：单价没实测，填一个估算值比留 0 更糟 ——
#   那会被当成真数字拿去算单位经济，而且没人记得它是估的
# 【填上之后】计费链路的其余部分已经接好了，不需要改任何别的地方
TELNYX_RATE_PER_MIN_MILLICENTS=

# ⭐ 通话对账的间隔（分钟）。**默认关**（不设或设 0）。
# 【为什么要有它】挂机 webhook 可能永远不来（Telnyx 的 connection 上可以
# 单独配 webhook 地址），而漏掉它是**静默漏账**：没记通话时长 = 没扣客户的
# 语音分钟，月底才发现，全程零报错。开着它就会定时去 Telnyx 把最近的通话
# 拉回来补上（连转录一起），幂等键挡着，两台机器同时跑也不会记两遍。
# 【建议】生产设 15。手动补一段历史：
#   pnpm exec tsx apps/api/src/ops/reconcileCalls.ts 4320
TELNYX_RECONCILE_MINUTES=15

# ───────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile（公开预约页防刷单）
#      Cloudflare Dashboard → Turnstile → Add site
# ───────────────────────────────────────────────────────────────────────────

# ⚠️⚠️ 两个都是 0x4AAAAAAA 开头，**长得几乎一样，极易填反**
#   Site key   = 放前端 HTML 里的，公开可见
#   Secret key = 放服务端校验的，不能泄露
# 页面上 Site key 在上、Secret key 在下，Secret 那个默认打码要点开
#   TURNSTILE_SITE_KEY=0x4AAAAAAABc1De2Fg3Hi4J
#   TURNSTILE_SECRET_KEY=0x4AAAAAAABc1De2Fg3Hi4Jk5Lm6No7Pq8Rs9Tu0Vw
# 【记法】Secret key 明显更长
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Google Maps Places API（可选：开店时自动填地址/营业时间）
# ───────────────────────────────────────────────────────────────────────────

# 【长这样】AIza 开头 + 35 字符 = 总共 39 字符
#   GOOGLE_MAPS_API_KEY=AIzaSyA1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6
# 【必做】创建后限制 HTTP Referer，否则会被盗刷
GOOGLE_MAPS_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
#  🔵 D · Phase 3 才需要（先留空）
# ═══════════════════════════════════════════════════════════════════════════

# Bright Data（抓 Google / Yelp 评价正文）
# 【长这样】API token 是长十六进制串；如果用代理方式则是
#   brd-customer-hl_a1b2c3d4-zone-serp:密码
BRIGHT_DATA_API_KEY=

# 数据集 id。留空用代码里的默认值；平台改版换数据集时在这里覆盖，不用改代码
BRIGHT_DATA_GOOGLE_REVIEWS_DATASET=
BRIGHT_DATA_YELP_REVIEWS_DATASET=

# 每条记录的抓取成本，单位毫分（1/1000 分）。默认 150 = 0.15 分/条。
# 只用于在 review_sync_runs 里估算费用，不参与向门店扣费
BRIGHT_DATA_COST_PER_RECORD_MILLICENTS=

# ── 评价同步定时任务（默认关）────────────────────────────────────────────────
#
# ⚠️ 打开之前先在 staging 上用 POST /v1/desk/reviews/sync 把整条链路走一遍：
# 看抓到的正文对不对、去重有没有生效、费用是不是预期的量级。
# 这条任务每一轮都真花钱，不该在没人看过一眼结果之前自己跑起来。
#
# 轮询间隔（分钟）。0 或留空 = 不启动。建议 60：抓取是异步的，
# 一轮触发、下一轮取结果
REVIEW_SYNC_INTERVAL_MINUTES=
# 距上次采集多久算「该同步了」。默认 720（12 小时）
REVIEW_SYNC_STALE_MINUTES=
# 一次采集卡在 running 多久算失败。默认 120 分钟。
# ⚠️ 这个上限不是可选项：唯一索引保证一店一平台只能有一次进行中的采集，
# 没有超时的话，一次永远不会 ready 的快照会把这家店的同步永久堵死
REVIEW_SYNC_TIMEOUT_MINUTES=
# 只抓最近 N 天 / 单次条数上限 / 一轮处理几家店
REVIEW_SYNC_DAYS_LIMIT=
REVIEW_SYNC_MAX_REVIEWS=
REVIEW_SYNC_BATCH=
# staging 手动同步入口。生产默认关（它会立刻产生抓取费用）
REVIEW_SYNC_MANUAL_ENABLED=

# ⭐ 健康表答案的应用层加密密钥（Phase 2 Kiosk）
# 32 字节，hex 或 base64。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 丢了 = 所有已签的健康表永久解不开。生产那把只进 CI Secret
FORM_ENCRYPTION_KEY=


# ═══════════════════════════════════════════════════════════════════════════
#  🧪 E · 测试通信（local / staging 专用，生产必须全部留空）
# ═══════════════════════════════════════════════════════════════════════════

# 投递模式：live（默认，真发）| capture（不出网，留在发件箱里供查看）
#
# 测试账号收不到真实邮件和短信，所以 local / staging 用 capture：
# 入队、渲染、分段、去重照常，只有「真的打出去」这一下是假的，
# 内容整封留在 email_outbox / sms_outbox，运营台「Test Inbox」那一页能看。
#
# ⚠️ 生产环境配成 capture 会**拒绝启动**（apps/api/src/comms/mode.ts）——
#    在生产吞掉确认信是一种静默故障，只能用起不来来防。
COMMUNICATION_DELIVERY_MODE=live

# 本机 Mailpit（Supabase 本地栈自带，本仓库开在 55324）。
# 配上之后 capture 的邮件会**顺带**投一份进去，方便在真的邮件客户端里看排版。
# 只接受 127.0.0.1 / localhost，且只在 capture 模式下生效。
# MAILPIT_URL=http://127.0.0.1:55324

# staging 固定手机验证码（Twilio Verify 没有 Test Credentials 这条路）。
# 4–8 位数字。⚠️ 必须同时配白名单，否则整个开关不生效。
# STAGING_OTP_CODE=

# 允许使用固定验证码的号码：整号或以 * 结尾的前缀，逗号分隔。
# 没有默认白名单 —— 不限号码等于「任何人都能用一个常量登录」。
# STAGING_OTP_PHONES=+1617555*

# capture 下来的测试消息保留几天（默认 7）。清理只删 captured，
# 真发出去的记录一行都不碰（packages/db/sql/0082）。
# CAPTURED_MESSAGE_RETAIN_DAYS=7
