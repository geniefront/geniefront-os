# Copy to .env.commerce-sandbox (gitignored); never paste secrets into chat.
# Use the separate JAYSEN LABS LLC sandbox shown in the Stripe account picker.
# Existing platform SaaS/AI STRIPE_SECRET_KEY is preserved.
COMMERCE_STRIPE_SECRET_KEY=
COMMERCE_STRIPE_MODE=test
STRIPE_COMMERCE_WEBHOOK_SECRET=
STRIPE_COMMERCE_ACCOUNT_WEBHOOK_SECRET=
# New merchant country; business identity and terms are collected by Stripe onboarding.
COMMERCE_CONNECT_COUNTRY=US
GF_CUSTOMER_COMMERCE_ENABLED=1
GF_CUSTOMER_COMMERCE_WORKER_ENABLED=1
# Local protected deposit-return page; generate a private random key and retain it across preview restarts.
BOOKING_MANAGE_PAGE_ENABLED=1
MANAGE_TOKEN_WRAP_KEY=
